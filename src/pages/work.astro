---
import Base from '../layouts/Base.astro';
---

<Base
  title="Our Work | Jabbar"
  description="Case studies from Jabbar - bespoke software solutions built for academic researchers, labs, and institutions."
>

  <main class="page-top">

    <!-- PAGE HERO -->
    <div class="container">
      <div class="page-hero">
        <span class="hero__eyebrow">Case Studies</span>
        <h1 class="page-hero__heading">Work that advances research.</h1>
        <p class="page-hero__sub">A look at what we've built, who we built it for, and the problems we solved along the way.</p>
      </div>
    </div>

    <!-- CASE STUDIES -->
    <div class="container" style="padding-bottom: 4rem;">
      <div style="display: flex; flex-direction: column; gap: 1.5px; background: var(--border); border: 1.5px solid var(--border); margin-top: 2rem;">

        <!-- Project 1: Digital Encyclopedia of Excavations in the Levant -->
        <div class="case-card case-card--featured" style="background: var(--white);">
          <div>
            <span class="case-card__tag">Digital Humanities &amp; Archaeology</span>
            <h2 class="case-card__title">Digital Encyclopedia of Excavations in the Levant</h2>
            <p class="case-card__body">Commissioned by Harvard University, this is a multilingual encyclopaedia of archaeological excavations across the Levant, published in English, Arabic, and Hebrew. Each entry cross-references sites with their known aliases, links to a hierarchical period taxonomy, and generates a citable PDF with a persistent DOI versioned on every update. Bibliographies are linked to Zotero and exportable in BibTeX or RIS. A geospatial map lets users explore the corpus by period and excavating institution.</p>
            <div class="case-card__outcomes">
              <span class="outcome-pill">English, Arabic &amp; Hebrew</span>
              <span class="outcome-pill">DOI minting via Zenodo</span>
              <span class="outcome-pill">Zotero bibliography export</span>
              <span class="outcome-pill">Geospatial site mapping</span>
            </div>
          </div>
          <div class="case-details">
            <div>
              <div class="case-detail__label">Institutions</div>
              <div class="logo-pair" style="margin-top: 0.375rem;">
                <img src="/harvard-logo.png" alt="Harvard University" class="institution-logo" style="margin-top: 0;">
                <div class="logo-pair__sep"></div>
                <img src="/holy-cross-logo.svg" alt="College of the Holy Cross" class="institution-logo logo-wordmark" style="margin-top: 0;">
              </div>
            </div>
            <div>
              <div class="case-detail__label">Domain</div>
              <div class="case-detail__value">Near Eastern Archaeology</div>
            </div>
            <div>
              <div class="case-detail__label">Type</div>
              <div class="case-detail__value">Reference platform &amp; database</div>
            </div>
            <div>
              <div class="case-detail__label">Audience</div>
              <div class="case-detail__value">Researchers, institutions, public</div>
            </div>
            <a href="/deel" class="arrow-link" style="margin-top: 0.5rem;">
              Read case study
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2.5 6H9.5M6.5 3L9.5 6L6.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a href="https://deelevant.com" target="_blank" rel="noopener" class="arrow-link" style="margin-top: 0.375rem;">
              Visit site
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 10L10 2M10 2H4M10 2v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>

      </div>
    </div>

    <!-- CTA -->
    <section class="cta-section">
      <div class="container">
        <h2 class="cta-section__heading">Working on something similar?</h2>
        <p class="cta-section__sub">Tell us about your project. We'll let you know if we're a good fit.</p>
        <a href="/contact" class="btn btn--light">Get in touch</a>
      </div>
    </section>

  </main>

</Base>
