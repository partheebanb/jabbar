---
import Base from '../layouts/Base.astro';
---

<Base
  title="Jabbar | Academic & Research Consultancy"
  description="Jabbar is a boutique consultancy building bespoke software solutions for academic researchers, labs, and institutions."
>

  <main class="page-top">

    <!-- HERO -->
    <section class="hero">
      <div class="container">
        <span class="hero__eyebrow">Academic &amp; Research Consultancy</span>
        <h1 class="hero__heading">
          Software built for<br>
          <em>the way research works.</em>
        </h1>
        <p class="hero__sub">
          We partner with researchers, labs, and institutions to design and build custom software tools - from data pipelines to public-facing platforms.
        </p>
        <div class="hero__actions">
          <a href="/work" class="btn btn--primary">See our work</a>
          <a href="/contact" class="btn btn--ghost">Get in touch</a>
        </div>
      </div>
    </section>

    <!-- STATS -->
    <section class="stats">
      <div class="container">
        <div class="stats__grid">
          <div class="stat">
            <div class="stat__value">Archaeology</div>
            <div class="stat__label">Digital humanities &amp; excavation data</div>
          </div>
          <div class="stat">
            <div class="stat__value">Anthropology</div>
            <div class="stat__label">Research storytelling &amp; public scholarship</div>
          </div>
          <div class="stat">
            <div class="stat__value">Amazon &amp; UBC</div>
            <div class="stat__label">Where we cut our teeth</div>
          </div>
          <div class="stat">
            <div class="stat__value">100%</div>
            <div class="stat__label">Tailored to each project</div>
          </div>
        </div>
      </div>
    </section>

    <!-- CLIENTS -->
    <section class="clients-section">
      <div class="container">
        <span class="clients-section__eyebrow">Institutions we've worked with</span>
        <div class="clients-grid">
          <div class="client-card">
            <img src="/harvard-logo.png" alt="Harvard University" class="client-card__logo">
            <div class="client-card__body">
              <div class="client-card__institution">Harvard University</div>
              <div class="client-card__project">Digital Encyclopedia of Excavations in the Levant</div>
              <div class="client-card__domain">Near Eastern Archaeology</div>
            </div>
            <div class="client-card__link">
              <a href="/deel" class="arrow-link">
                Read case study
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2.5 6H9.5M6.5 3L9.5 6L6.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>
          <div class="client-card">
            <img src="/ubc-logo.png" alt="University of British Columbia" class="client-card__logo">
            <div class="client-card__body">
              <div class="client-card__institution">University of British Columbia</div>
              <div class="client-card__project">Human Stories: Sacrifice Decoded</div>
              <div class="client-card__domain">Bioarchaeology &amp; Anthropology</div>
            </div>
            <div class="client-card__link">
              <a href="/hssd" class="arrow-link">
                Read case study
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2.5 6H9.5M6.5 3L9.5 6L6.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="section">
      <div class="container">
        <div class="section__header">
          <div>
            <span class="section__eyebrow">What we do</span>
            <h2 class="section__heading">Built around how research actually works.</h2>
          </div>
        </div>
        <div class="services__grid">
          <div class="service-card">
            <svg class="service-card__icon" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="20" cy="14" r="7" stroke="currentColor" stroke-width="1.75"/>
              <path d="M8 34c0-6.627 5.373-12 12-12s12 5.373 12 12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
            </svg>
            <h3 class="service-card__title">Public research platforms</h3>
            <p class="service-card__body">Your findings deserve an audience beyond the journal. We build sites for research initiatives and multi-institution projects that communicate clearly to press, educators, and the public - with a CMS your team can update without us.</p>
          </div>
          <div class="service-card">
            <svg class="service-card__icon" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="4" y="8" width="32" height="22" rx="2" stroke="currentColor" stroke-width="1.75"/>
              <path d="M13 30v4M27 30v4M9 34h22" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
              <path d="M10 20l5-5 5 5 6-7" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <h3 class="service-card__title">Interactive data visualisation</h3>
            <p class="service-card__body">Fieldwork data, excavation sites, isotope results - we turn structured research data into geospatial maps, timelines, and filterable interfaces that let anyone explore what took years to collect.</p>
          </div>
          <div class="service-card">
            <svg class="service-card__icon" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="6" y="6" width="28" height="28" rx="2" stroke="currentColor" stroke-width="1.75"/>
              <path d="M6 14h28" stroke="currentColor" stroke-width="1.75"/>
              <path d="M14 20h12M14 26h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <circle cx="11" cy="10" r="1.5" fill="currentColor"/>
              <circle cx="16" cy="10" r="1.5" fill="currentColor"/>
            </svg>
            <h3 class="service-card__title">Research databases &amp; catalogues</h3>
            <p class="service-card__body">We build structured repositories that reflect the actual messiness of scholarly data - multilingual records, citable entries with persistent DOIs, bibliography exports, and editorial workflows built for researchers, not IT administrators.</p>
          </div>
        </div>
        <p style="margin-top: 1.75rem; font-size: 0.9375rem; color: var(--muted);">
          Have something else in mind? We're open to other web-based projects on a case-by-case basis - <a href="/contact" style="color: var(--navy); text-decoration: underline; text-underline-offset: 3px;">get in touch</a> and we'll let you know if we're a good fit.
        </p>
      </div>
    </section>

    <!-- HOW WE WORK -->
    <section class="section">
      <div class="container">
        <span class="section__eyebrow">How we work</span>
        <h2 class="section__heading" style="margin-bottom: 3rem;">Our process</h2>
        <div class="process-list">
          <div class="process-item">
            <h3 class="process-item__title">Discovery</h3>
            <p class="process-item__body">We start by understanding your research, your team's workflow, and where the real pain points are - not just the surface request.</p>
          </div>
          <div class="process-item">
            <h3 class="process-item__title">Scoping</h3>
            <p class="process-item__body">We define a precise, achievable scope together - what gets built in phase one, what gets deferred, and why.</p>
          </div>
          <div class="process-item">
            <h3 class="process-item__title">Build</h3>
            <p class="process-item__body">We build iteratively, sharing working software early and often so you can shape it based on real use - not mockups.</p>
          </div>
          <div class="process-item">
            <h3 class="process-item__title">Handoff</h3>
            <p class="process-item__body">Clean documentation, a walkthrough, and continued support. We make sure your team can own and extend what we built together.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-section">
      <div class="container">
        <h2 class="cta-section__heading">Have a research problem<br>that needs a software solution?</h2>
        <p class="cta-section__sub">We work with labs, departments, and individual researchers. Reach out and tell us what you're building.</p>
        <a href="/contact" class="btn btn--light">Start the conversation</a>
      </div>
    </section>

  </main>

</Base>
