<Base
  title="DEEL Case Study | Jabbar"
  description="How Jabbar built the Digital Encyclopedia of Excavations in the Levant for Harvard University."
>

  <main class="page-top">

    <div class="container">

      <!-- HERO -->
      <div class="cs-hero">
        <a href="/work" class="cs-hero__back">
